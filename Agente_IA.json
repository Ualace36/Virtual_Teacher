    {
      "parameters": {
        "functionCode": "const textoOriginal = $json.output || '';\nconst partes = [];\nlet index = 0;\n\nwhile (index < textoOriginal.length) {\n  let limite = index + 200;\n  if (limite >= textoOriginal.length) {\n    partes.push(textoOriginal.slice(index));\n    break;\n  }\n\n  const ultimaEspaco = textoOriginal.lastIndexOf(' ', limite);\n  const corte = ultimaEspaco > index ? ultimaEspaco : limite;\n\n  partes.push(textoOriginal.slice(index, corte).trim());\n  index = corte + 1;\n}\n\nreturn partes.map((texto, i) => ({\n  json: {\n    texto,\n    idParte: i + 1,\n    totalPartes: partes.length\n  }\n}));"
      },
